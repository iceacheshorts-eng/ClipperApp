<Window x:Class="ClipStudio.ClipEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClipStudio"
        xmlns:vm="clr-namespace:ClipStudio.ViewModels"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:ClipStudio.Converters"
        mc:Ignorable="d"
        Title="Edit clip" Height="700" Width="1150"
        WindowStartupLocation="CenterOwner"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">

    <Window.Resources>
        <local:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="WordButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="TextElement.FontSize" Value="16" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Background" Value="#3342A5F5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOutside}" Value="True">
                    <Setter Property="Opacity" Value="0.35" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                    <Setter Property="Foreground" Value="IndianRed" />
                    <Setter Property="Opacity" Value="0.6" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                                    <Line X1="0" Y1="12" X2="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}" Y2="12" Stroke="IndianRed" StrokeThickness="1.5" />
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsDeleted}" Value="True" />
                        <Condition Binding="{Binding IsOutside}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Opacity" Value="0.2" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsAnchor}" Value="True">
                    <Setter Property="Background" Value="LightBlue" />
                    <Setter Property="Foreground" Value="Black" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="460" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Preview Column -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Video Player -->
            <Grid x:Name="PreviewGrid" Grid.Row="0" Background="Black" SizeChanged="PreviewGrid_SizeChanged">
                <MediaElement x:Name="Player"
                              LoadedBehavior="Manual"
                              UnloadedBehavior="Manual"
                              ScrubbingEnabled="True"
                              Stretch="Uniform"
                              IsMuted="False"
                              MediaOpened="Player_MediaOpened"
                              MediaFailed="Player_MediaFailed"/>
                <Canvas x:Name="GuideCanvas" IsHitTestVisible="False" />
            </Grid>

            <!-- Preview Controls -->
            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Play" x:Name="PlayPauseButton" Click="PlayPauseButton_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" />
                    <Button Content="Restart" x:Name="RestartButton" Click="RestartButton_Click" Style="{StaticResource MaterialDesignOutlinedButton}" />
                </StackPanel>

                <Slider x:Name="SeekSlider"
                        Minimum="0" Maximum="1"
                        ValueChanged="SeekSlider_ValueChanged"
                        Margin="0,0,0,8"/>

                <TextBlock x:Name="TimeLabel" Text="0:00 / 0:00" HorizontalAlignment="Right" Margin="0,0,0,8" />

                <TextBlock Text="{Binding PreviewError}" Foreground="IndianRed" TextWrapping="Wrap" Margin="0,0,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="Guide is approximate: the real crop follows faces." FontSize="11" Foreground="Gray" />
            </StackPanel>
        </Grid>

        <!-- Editor Column -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top row: info and warnings -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Original duration: " FontWeight="Bold" />
                <TextBlock Text="{Binding OriginalDuration, StringFormat={}{0:F1}s}" Margin="0,0,16,0" />

                <TextBlock Text="Edited duration: " FontWeight="Bold" />
                <TextBlock Text="{Binding EditedDuration, StringFormat={}{0:F1}s}" Margin="0,0,16,0" />

                <TextBlock Text="Cuts: " FontWeight="Bold" />
                <TextBlock Text="{Binding CutCount}" />
            </StackPanel>

            <TextBlock Text="{Binding WarningText}" Foreground="Orange" Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <!-- Mode selector -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Mode:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,16,0" />

            <RadioButton Content="Delete words" GroupName="EditorMode" Margin="0,0,16,0"
                         IsChecked="{Binding Mode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static vm:EditorMode.DeleteWords}}" />
            <RadioButton Content="Delete range" GroupName="EditorMode" Margin="0,0,16,0"
                         IsChecked="{Binding Mode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static vm:EditorMode.DeleteRange}}" />
            <RadioButton Content="Set start" GroupName="EditorMode" Margin="0,0,16,0"
                         IsChecked="{Binding Mode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static vm:EditorMode.SetStart}}" />
            <RadioButton Content="Set end" GroupName="EditorMode"
                         IsChecked="{Binding Mode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static vm:EditorMode.SetEnd}}" />
        </StackPanel>

        <!-- Center: text-based editor -->
        <ScrollViewer Grid.Row="2" Background="{DynamicResource MaterialDesignTextFieldBoxBackground}" Padding="16" Margin="0,0,0,16">
            <ItemsControl x:Name="WordsItemsControl" ItemsSource="{Binding Words}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Text}"
                                Command="{Binding DataContext.WordClickCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource WordButtonStyle}">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Play from here" Click="PlayFromHere_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Bottom row: status and buttons -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             Value="0" IsIndeterminate="True" Width="20" Height="20" Margin="0,0,8,0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Mark fillers" Command="{Binding MarkFillersCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" />
                <Button Content="Reset" Command="{Binding ResetCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" />
                <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" />
                <Button Content="Apply" Command="{Binding ApplyCommand}" />
            </StackPanel>
        </Grid>
        </Grid>
    </Grid>
</Window>
